{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "egglab": {
      "type": "local",
      "command": ["node", "./panel/mcp-server.mjs"],
      "enabled": true,
      "timeout": 4200000
    }
  },
  "agent": {
    "egglab": {
      "description": "EggLab design agent for PhotoCraft",
      "mode": "primary",
      "model": "inferx/deepseek-v4.1-flash-1017-basic",
      "prompt": "{file:./panel/AGENT.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    }
  }
}
