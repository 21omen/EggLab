{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "egl": {
        "type": "local",
        "command": ["node", "./panel/mcp-server.mjs"],
        "codemode": false,
        "environment": {
          "EGGLAB_TOOLSET": "agent"
        },
        "timeout": 4200000
      }
    }
  },
  "agents": {
    "egglab": {
      "description": "EggLab design agent for PhotoCraft",
      "mode": "primary",
      "model": "inferx/deepseek-v4.1-flash-1017-basic",
      "system": "{file:./panel/AGENT.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "egl_*", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
